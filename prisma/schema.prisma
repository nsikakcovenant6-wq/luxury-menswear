generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("postgresql://postgres.vyslvcgfhycbbkcvxbve:Blessycovenan@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true")
  directUrl= env("postgresql://postgres.vyslvcgfhycbbkcvxbve:Blessycovenan@aws-0-eu-west-2.pooler.supabase.com:5432/postgres")
}

model Cart {
  id        String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime

  User     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  CartItem CartItem[]

  @@map("Cart")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  Product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  Cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("CartItem")
}

model Measurement {
  id        String   @id
  userId    String
  height    String?
  chest     String?
  waist     String?
  neck      String?
  shoulder  String?
  sleeve    String?
  trouser   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Measurement")
}

model Order {
  id                 String    @id
  userId             String
  total              Float
  status             String    @default("PENDING")
  paymentMethod      String    @default("BANK_TRANSFER")
  paymentStatus      String    @default("PENDING")
  paymentReference   String?
  paymentConfirmedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime

  User      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  OrderItem OrderItem[]

  @@index([createdAt])
  @@index([paymentStatus])
  @@index([status])
  @@index([userId])
  @@map("Order")
}

model OrderItem {
  id        String @id
  orderId   String
  productId String
  quantity  Int
  price     Float

  Product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  Order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("OrderItem")
}

model Product {
  id             String   @id
  slug           String   @unique
  name           String
  category       String
  description    String
  image          String
  imagesJson     String   @default("[]")
  colorsJson     String   @default("[]")
  sizesJson      String   @default("[]")
  price          Float
  compareAtPrice Float?
  stock          Int      @default(0)
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  isNew          Boolean  @default(false)
  isFeatured     Boolean  @default(false)
  inStock        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  CartItem  CartItem[]
  OrderItem OrderItem[]

  @@index([inStock])
  @@index([isFeatured])
  @@index([category])
  @@map("Product")
}

model StoreSettings {
  id            String   @id
  storeName     String   @default("Benkaso Collection")
  bankName      String?
  accountName   String?
  accountNumber String?
  whatsappNumber String?
  whatsappMessage String?
  updatedAt     DateTime

  @@map("StoreSettings")
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now())
  updatedAt DateTime

  Cart        Cart?
  Measurement Measurement[]
  Order       Order[]

  @@index([role])
  @@map("User")
}